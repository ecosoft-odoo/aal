<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoice_form_inherit_sale_discount" model="ir.ui.view">
        <field name="name">account.invoice.form.sale.discount</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_untaxed']" position="after" >
                <field name="discount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='amount_tax']" position="after" >
                <field name="discount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
